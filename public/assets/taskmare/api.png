<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 400 240' width='100%' height='100%'>
  <defs>
    <linearGradient id='bgApi' x1='0%' y1='0%' x2='100%' y2='100%'>
      <stop offset='0%' stop-color='#0f172a'/>
      <stop offset='100%' stop-color='#1e293b'/>
    </linearGradient>
    <linearGradient id='amberGrad' x1='0%' y1='0%' x2='100%' y2='0%'>
      <stop offset='0%' stop-color='#f59e0b'/>
      <stop offset='100%' stop-color='#ef4444'/>
    </linearGradient>
  </defs>
  <rect width='400' height='240' rx='16' fill='url(#bgApi)'/>
  <!-- Central Server Nodes -->
  <g transform='translate(150, 50)'>
    <!-- Server Rack 1 -->
    <rect width='100' height='32' rx='6' fill='#1e293b' stroke='#f59e0b' stroke-width='1.5'/>
    <circle cx='15' cy='16' r='4' fill='#10b981'/>
    <line x1='30' y1='16' x2='75' y2='16' stroke='#475569' stroke-width='3' stroke-linecap='round'/>
    <circle cx='85' cy='16' r='3' fill='#f59e0b'/>
    <!-- Server Rack 2 -->
    <rect y='40' width='100' height='32' rx='6' fill='#1e293b' stroke='#f59e0b' stroke-width='1.5'/>
    <circle cx='15' cy='56' r='4' fill='#10b981'/>
    <line x1='30' y1='56' x2='70' y2='56' stroke='#475569' stroke-width='3' stroke-linecap='round'/>
    <circle cx='85' cy='56' r='3' fill='#3b82f6'/>
    <!-- Database Cylinder 3 -->
    <g transform='translate(10, 80)'>
      <path d='M0,10 C0,4 18,0 40,0 C62,0 80,4 80,10 L80,35 C80,41 62,45 40,45 C18,45 0,41 0,35 Z' fill='#0f172a' stroke='#f59e0b' stroke-width='1.5'/>
      <ellipse cx='40' cy='10' rx='40' ry='10' fill='#1e293b' stroke='#f59e0b' stroke-width='1.5'/>
      <text x='40' y='32' fill='#f59e0b' font-family='sans-serif' font-size='10' font-weight='bold' text-anchor='middle'>SQL / DB</text>
    </g>
  </g>
  <!-- API Connecting Wires -->
  <path d='M80,100 L140,100' stroke='#f59e0b' stroke-width='2' stroke-dasharray='4,4'/>
  <path d='M260,100 L320,100' stroke='#10b981' stroke-width='2' stroke-dasharray='4,4'/>
  <!-- Endpoint tags -->
  <g transform='translate(35, 87)'>
    <rect width='70' height='26' rx='8' fill='#1e293b' stroke='#f59e0b' stroke-width='1'/>
    <text x='35' y='17' fill='#f59e0b' font-family='sans-serif' font-size='10' font-weight='bold' text-anchor='middle'>REST API</text>
  </g>
  <g transform='translate(295, 87)'>
    <rect width='75' height='26' rx='8' fill='#1e293b' stroke='#10b981' stroke-width='1'/>
    <text x='37' y='17' fill='#10b981' font-family='sans-serif' font-size='10' font-weight='bold' text-anchor='middle'>WebSockets</text>
  </g>
  <g transform='translate(145, 195)'>
    <rect width='110' height='26' rx='8' fill='#1e293b' stroke='#38bdf8' stroke-width='1'/>
    <text x='55' y='17' fill='#38bdf8' font-family='sans-serif' font-size='10' font-weight='bold' text-anchor='middle'>Secure Cloud</text>
  </g>
</svg>