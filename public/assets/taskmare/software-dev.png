<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 400 240' width='100%' height='100%'>
  <defs>
    <linearGradient id='bgSoftware' x1='0%' y1='0%' x2='100%' y2='100%'>
      <stop offset='0%' stop-color='#0f172a'/>
      <stop offset='100%' stop-color='#1e293b'/>
    </linearGradient>
    <linearGradient id='codeGrad' x1='0%' y1='0%' x2='100%' y2='0%'>
      <stop offset='0%' stop-color='#ED1B2F'/>
      <stop offset='100%' stop-color='#f97316'/>
    </linearGradient>
  </defs>
  <rect width='400' height='240' rx='16' fill='url(#bgSoftware)'/>
  <!-- Browser window frame -->
  <rect x='70' y='35' width='260' height='165' rx='12' fill='#1e293b' stroke='#334155' stroke-width='1.5'/>
  <!-- Browser Top Bar -->
  <rect x='70' y='35' width='260' height='28' rx='12' fill='#0f172a'/>
  <circle cx='86' cy='49' r='4' fill='#ef4444'/>
  <circle cx='98' cy='49' r='4' fill='#eab308'/>
  <circle cx='110' cy='49' r='4' fill='#22c55e'/>
  <rect x='130' y='42' width='130' height='14' rx='7' fill='#1e293b'/>
  <!-- Dashboard UI elements inside browser -->
  <!-- Left mini sidebar -->
  <rect x='78' y='71' width='45' height='120' rx='6' fill='#0f172a'/>
  <rect x='84' y='80' width='33' height='6' rx='3' fill='#475569'/>
  <rect x='84' y='92' width='28' height='5' rx='2.5' fill='#334155'/>
  <rect x='84' y='103' width='30' height='5' rx='2.5' fill='#334155'/>
  <!-- Main analytics cards -->
  <rect x='131' y='71' width='90' height='48' rx='8' fill='#0f172a' stroke='#ED1B2F' stroke-width='1' stroke-opacity='0.4'/>
  <rect x='140' y='79' width='40' height='6' rx='3' fill='#ED1B2F'/>
  <rect x='140' y='91' width='55' height='12' rx='4' fill='#e2e8f0'/>
  <!-- Second card -->
  <rect x='229' y='71' width='93' height='48' rx='8' fill='#0f172a' stroke='#38bdf8' stroke-width='1' stroke-opacity='0.4'/>
  <rect x='238' y='79' width='45' height='6' rx='3' fill='#38bdf8'/>
  <rect x='238' y='91' width='55' height='12' rx='4' fill='#e2e8f0'/>
  <!-- Graph chart -->
  <rect x='131' y='127' width='191' height='64' rx='8' fill='#0f172a'/>
  <polyline points='145,175 175,155 205,165 240,140 280,150 310,135' fill='none' stroke='url(#codeGrad)' stroke-width='2.5' stroke-linecap='round'/>
  <!-- Floating tech tags -->
  <g transform='translate(35, 140)'>
    <rect width='70' height='26' rx='8' fill='#0f172a' stroke='#38bdf8' stroke-width='1'/>
    <text x='35' y='17' fill='#38bdf8' font-family='sans-serif' font-size='10' font-weight='bold' text-anchor='middle'>React</text>
  </g>
  <g transform='translate(295, 160)'>
    <rect width='76' height='26' rx='8' fill='#0f172a' stroke='#3b82f6' stroke-width='1'/>
    <text x='38' y='17' fill='#60a5fa' font-family='sans-serif' font-size='10' font-weight='bold' text-anchor='middle'>TypeScript</text>
  </g>
</svg>