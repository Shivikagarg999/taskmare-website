<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 400 240' width='100%' height='100%'>
  <defs>
    <linearGradient id='bgIos' x1='0%' y1='0%' x2='100%' y2='100%'>
      <stop offset='0%' stop-color='#0f172a'/>
      <stop offset='100%' stop-color='#1e1b4b'/>
    </linearGradient>
    <linearGradient id='appleGrad' x1='0%' y1='0%' x2='100%' y2='100%'>
      <stop offset='0%' stop-color='#ffffff'/>
      <stop offset='100%' stop-color='#94a3b8'/>
    </linearGradient>
    <filter id='glowBlue' x='-20%' y='-20%' width='140%' height='140%'>
      <feGaussianBlur stdDeviation='8' result='blur'/>
      <feComposite in='SourceGraphic' in2='blur' operator='over'/>
    </filter>
  </defs>
  <rect width='400' height='240' rx='16' fill='url(#bgIos)'/>
  <circle cx='200' cy='120' r='90' fill='#38bdf8' opacity='0.08' filter='url(#glowBlue)'/>
  <!-- iPhone frame -->
  <rect x='130' y='30' width='140' height='180' rx='24' fill='#18181b' stroke='#3f3f46' stroke-width='2'/>
  <rect x='138' y='38' width='124' height='164' rx='18' fill='#09090b'/>
  <!-- Dynamic Island -->
  <rect x='178' y='44' width='44' height='10' rx='5' fill='#000000' stroke='#27272a' stroke-width='1'/>
  <!-- Apple Silhouette -->
  <g transform='translate(182, 85) scale(0.9)'>
    <path d='M18.8,13.8 C18.8,9.4 22.4,7.2 22.6,7 C20.5,4 17.3,3.5 16.2,3.5 C13.5,3.2 10.8,5.1 9.4,5.1 C8,5.1 5.7,3.5 3.5,3.5 C0.7,3.5 -1.9,5.2 -3.4,7.8 C-6.3,12.9 -4.2,20.4 -1.4,24.4 C0,26.4 1.6,28.6 3.8,28.5 C5.9,28.4 6.7,27.1 9.3,27.1 C11.8,27.1 12.6,28.5 14.8,28.5 C17.1,28.5 18.5,26.5 19.9,24.5 C21.5,22.1 22.2,19.8 22.3,19.7 C22.1,19.6 18.8,18.3 18.8,13.8 Z' fill='url(#appleGrad)'/>
    <path d='M14.6,0.3 C15.8,-1.2 16.6,-3.2 16.4,-5.2 C14.7,-5.1 12.6,-4.1 11.4,-2.6 C10.4,-1.4 9.5,0.6 9.8,2.6 C11.7,2.7 13.5,1.7 14.6,0.3 Z' fill='url(#appleGrad)'/>
  </g>
  <!-- Card in iPhone -->
  <rect x='148' y='130' width='104' height='32' rx='10' fill='#27272a' stroke='#38bdf8' stroke-width='1' stroke-opacity='0.4'/>
  <rect x='156' y='138' width='55' height='7' rx='3.5' fill='#38bdf8'/>
  <rect x='156' y='149' width='38' height='4' rx='2' fill='#71717a'/>
  <!-- Tech Floating Tags -->
  <g transform='translate(50, 70)'>
    <rect width='70' height='26' rx='8' fill='#18181b' stroke='#f97316' stroke-width='1'/>
    <text x='35' y='17' fill='#f97316' font-family='sans-serif' font-size='10' font-weight='bold' text-anchor='middle'>Swift</text>
  </g>
  <g transform='translate(280, 80)'>
    <rect width='76' height='26' rx='8' fill='#18181b' stroke='#0ea5e9' stroke-width='1'/>
    <text x='38' y='17' fill='#0ea5e9' font-family='sans-serif' font-size='10' font-weight='bold' text-anchor='middle'>SwiftUI</text>
  </g>
  <g transform='translate(275, 150)'>
    <rect width='80' height='26' rx='8' fill='#18181b' stroke='#a855f7' stroke-width='1'/>
    <text x='40' y='17' fill='#a855f7' font-family='sans-serif' font-size='10' font-weight='bold' text-anchor='middle'>TestFlight</text>
  </g>
</svg>